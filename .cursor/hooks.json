{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/mark-tests-pending.ps1",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/run-tests.ps1",
        "timeout": 900,
        "loop_limit": 3
      }
    ]
  }
}
